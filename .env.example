# Port untuk server lokal (server.js). Default 5555 kalau dikosongkan.
PORT=5555

# Token read-write dari Vercel Blob (Dashboard > Storage > token). Wajib untuk upload ke Blob.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# Origins yang diizinkan CORS, pisahkan dengan koma. Kosongkan untuk izinkan semua (*).
ALLOWED_ORIGINS=http://localhost:5555,https://your-domain.vercel.app

# Base URL publik aplikasi (dipakai untuk vanity URL di server lokal). Kosongkan untuk auto localhost.
BASE_URL=http://localhost:5555
